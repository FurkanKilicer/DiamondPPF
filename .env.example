# Site URL (canonical, sitemap, Origin allowlist). Gizli değildir.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase proje URL'si. Dashboard → Settings → API → Project URL
# CMS oturumu (tarayıcı + sunucu, publishable key ile). Gizli değildir.
NEXT_PUBLIC_SUPABASE_URL=

# Publishable / anon key. Dashboard → Settings → API Keys.
# Tarayıcıya gider; service-role değildir. Gerçek değeri git'e yazmayın.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# İsteğe bağlı yedek ad (eski anon JWT). Publishable yoksa okunur.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Quote API (yalnızca sunucu). CMS kullanıcı işlemlerinde kullanılmaz.
# Anon/public key değil; tarayıcıya service-role koyma.
SUPABASE_URL=

# Yalnızca sunucu. Service role RLS'i bypass eder. Asla NEXT_PUBLIC_ öneki kullanma.
# Dashboard → Settings → API → service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=

# Upstash Redis REST (dağıtık rate limit). Gizli; NEXT_PUBLIC_ kullanma.
# Upstash Console → Redis → REST URL ve REST TOKEN
# Geliştirmede boş bırakılabilir (limit atlanır; üretim koruması sayılmaz).
# Üretimde (NODE_ENV=production) boşsa POST /api/quotes fail-closed 503 döner.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# x-forwarded-for yalnızca güvenilir proxy arkasında okunur.
# Vercel otomatik güvenilir (VERCEL=1). Kendi reverse proxy'niz varsa:
# RATE_LIMIT_TRUST_PROXY=true
#
# Vercel Firewall ayrı bir platform katmanıdır; bu uygulama onu açmaz veya
# yapılandırmaz. WAF kuralı yoksa Firewall koruması etkin sayılmamalıdır.
